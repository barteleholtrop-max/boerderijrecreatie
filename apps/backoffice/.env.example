# Inloggen: via Supabase met Google of e-mail en wachtwoord, altijd met Authenticator.
# Zie docs/INLOGGEN-BIJ-LIVEGANG.md. Er zijn geen wachtwoorden meer in dit bestand.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Alleen op de server, nodig om een Authenticator weg te halen als iemand zijn telefoon kwijt is.
SUPABASE_SERVICE_ROLE_KEY=
# Minstens 32 tekens.
AUTH_SECRET=
# Eén login voor meerdere eigen adressen, bijv. example.nl (leeg = alleen dit adres).
SESSION_COOKIE_DOMAIN=
# Achtergrondwerk (Weekassistent, opruimen na 14 dagen). Zet op 0 om uit te schakelen.
ASSISTANT_WORKER=1
# Weekassistent (fase 2). Zonder sleutel bewaart de assistent berichten maar antwoordt hij niet.
# Stel ook een maandlimiet in bij de Anthropic Console (Limits) als vangnet voor de kosten.
ANTHROPIC_API_KEY=
# Optioneel: model (standaard claude-opus-5-5), denkniveau low/medium/high (standaard medium), max. API-aanroepen per 24 uur (standaard 300).
ASSISTANT_MODEL=
ASSISTANT_EFFORT=
ASSISTANT_DAILY_LIMIT=
# Gesprekken: Gmail-koppeling en Google Agenda's. Zie docs/KLANTGESPREKKEN-GMAIL.md. Alleen server-side; nooit in Git.
# De OAuth-client (client-ID/-geheim), mailbox en label stel je bij voorkeur in bij Systeem & koppelingen → Gmail
# (versleuteld opgeslagen). Deze variabelen zijn de terugval als daar niets staat.
GUEST_GOOGLE_CLIENT_ID=
GUEST_GOOGLE_CLIENT_SECRET=
# Mailbox en klantlabel (standaard info@example.nl en "TODO Klanten"); het label-ID wordt uit het account opgehaald.
GMAIL_MAILBOX=
GMAIL_CUSTOMER_LABEL=
# Verzenden vanuit de backoffice staat standaard uit. Zet alleen in de echte omgeving op 1, na een test met een eigen adres.
MAIL_SEND_ENABLED=0
# WhatsApp, Messenger en Instagram versturen vanuit Gesprekken (docs/WHATSAPP-META.md); standaard uit.
META_SEND_ENABLED=0
# Automatische synchronisatie (Gmail elke 5 minuten, agenda's elke 15 minuten) via het achtergrondwerk; 0 = alleen handmatig.
MAIL_SYNC=1
APP_DATA_DIR=./var
SHEETS_CONFIG_KEY=
GOOGLE_SHEETS_WEBAPP_URL=
PORT=3001
APP_ORIGIN=http://localhost:3001
# Eerste eigenaar: is er nog niemand met toegang, dan wordt dit e-mailadres eigenaar (daarna beheer je dat bij Toegang).
EERSTE_EIGENAAR=
